# ==============================================================================
# Variáveis de Ambiente de Exemplo — Plataforma de Gestão e Análise de Estudos
# Copie este arquivo para .env na raiz antes de iniciar a aplicação.
# ==============================================================================

# ------------------------------------------------------------------------------
# Banco de Dados PostgreSQL (Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=estudos_db
POSTGRES_PORT=5432

# URL de Conexão do Prisma ORM para PostgreSQL
# Formato: postgresql://<usuario>:<senha>@<host>:<porta>/<banco>?schema=<schema>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estudos_db?schema=public"

# ------------------------------------------------------------------------------
# Backend API (apps/api)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
SESSION_SECRET="chave_secreta_super_segura_para_desenvolvimento_com_32_bytes!"
CLIENT_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# ------------------------------------------------------------------------------
# Frontend Web (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:3001"
