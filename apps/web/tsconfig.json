{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-types",
    "paths": {
      "@/*": ["./src/*"],
      "@estudos/domain": ["../../packages/domain/src/index.ts"]
    }
  },
  "references": [
    { "path": "../../packages/domain" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "dist-types", "vite.config.ts", "vitest.config.ts"]
}
